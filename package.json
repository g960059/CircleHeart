{
  "name": "circleheart",
  "private": true,
  "version": "0.0.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "verify:registry:current": "vite-node --script tools/registry/verifyCurrentModelPublicationV1.ts",
    "fit:case": "vite-node --script tools/scientific/runMainWireCaseFittingV1.ts",
    "fit:registry": "vite-node --script tools/scientific/runMainWireRegistryFittingV1.ts",
    "fit:registry:family": "vite-node --script tools/scientific/runMainWireRegistryFamilyV1.ts",
    "fit:registry:refresh": "vite-node --script tools/scientific/refreshMainWireRegistryMaterialV1.ts",
    "fit:registry:prepare": "vite-node --script tools/scientific/prepareMainWireRegistryReviewV1.ts",
    "fit:registry:prepare-launches": "vite-node --script tools/scientific/prepareRegisteredLaunchAnalysesV1.ts",
    "audit:case-metrics": "vite-node --script tools/scientific/auditMainWireWorkbenchMetricsV1.ts",
    "observe:case": "vite-node --script tools/scientific/reobserveMainWireCaseV1.ts",
    "export:model-document": "vite-node --script tools/modelDocumentation/exportSavedDocumentV1.ts",
    "dev": "vite",
    "typecheck": "tsc --noEmit --pretty false",
    "build": "npm run typecheck && vite build",
    "build:public-content": "npm run build && vite build --ssr server/publicContentServerV1.ts --outDir dist-public-content --emptyOutDir",
    "start:public-content": "node dist-public-content/publicContentServerV1.js",
    "compile:model:execution-plan": "vite-node --script tools/model/compileMainWireExecutionPlanV1.ts",
    "publish:registry:main-wire-v3": "vite-node --script tools/registry/publishMainWireIntegratedStudioModelV3.ts",
    "verify:registry:model-surface": "vite-node --script tools/registry/verifyModelSurfaceReleaseV1.ts",
    "publish:registry:model-surface": "vite-node --script tools/registry/publishModelSurfaceReleaseV1.ts",
    "activate:registry:model-bundle": "vite-node --script tools/registry/activateModelBundleV1.ts",
    "author:login": "vite-node --script tools/authoring/runStudioAuthoringAuthV1.ts login",
    "author:status": "vite-node --script tools/authoring/runStudioAuthoringAuthV1.ts status",
    "author:logout": "vite-node --script tools/authoring/runStudioAuthoringAuthV1.ts logout",
    "author:content": "vite-node --script tools/authoring/runStudioAuthoringCommandV1.ts",
    "preview": "vite preview",
    "check:repository-hygiene": "node tools/repository/checkRepositoryHygiene.mjs",
    "test": "npm run test:fast",
    "test:fast": "node tools/testing/runFastVitest.mjs",
    "test:pr": "CIRCLEHEART_TEST_SUITE_LABEL='PR smoke suite' CIRCLEHEART_VITEST_CONFIG=vitest.pr.config.ts node tools/testing/runFastVitest.mjs",
    "test:browser": "playwright test",
    "benchmark:workbench:live": "npm run build && playwright test --config playwright.performance.config.ts",
    "benchmark:workbench:exact-presentation": "vite-node --script tools/performance/benchmarkMainWirePresentationBatchV1.ts",
    "benchmark:model:execution-plan-binding": "vite-node --script tools/performance/benchmarkExecutionPlanBindingV1.ts",
    "benchmark:kernel:flat-authority": "vite-node --script tools/performance/benchmarkMainWireFlatAuthorityV1.ts",
    "benchmark:kernel:coronary-scratch": "vite-node --script tools/performance/benchmarkCoronaryBackwardEulerScratchV2.ts",
    "benchmark:kernel:coupled-newton": "vite-node --script tools/performance/benchmarkMainWireCoupledNewtonV1.ts",
    "benchmark:kernel:coupled-trajectory": "vite-node --script tools/performance/benchmarkMainWireFlatCoupledTrajectoryV1.ts",
    "benchmark:kernel:land-output": "vite-node --script tools/performance/benchmarkLandContinuousOutputV1.ts",
    "benchmark:kernel:vascular-pv-inverse": "vite-node --script tools/performance/benchmarkVascularPvInverseV1.ts",
    "benchmark:analysis:tbv-sweep": "vite-node --script tools/performance/benchmarkMainWireTbvSweepV1.ts",
    "profile:kernel:flat-authority": "vite-node --script tools/performance/profileMainWireFlatAuthorityV1.ts",
    "inspect:kernel:flat-state-shape": "vite-node --script tools/performance/inspectMainWireFlatStateShapeV1.ts",
    "inspect:kernel:accepted-state-identity": "vite-node --script tools/performance/inspectMainWireAcceptedStateIdentityV1.ts",
    "inspect:kernel:typed-owner-coverage": "vite-node --script tools/performance/inspectMainWireTypedOwnerCoverageV1.ts",
    "verify:workbench:performance": "CIRCLEHEART_PERF_ENFORCE=1 npm run benchmark:workbench:live",
    "test:supabase": "supabase test db --local supabase/tests/database && node tools/testing/verifyAuthoringRetryMigrationUpgrade.mjs",
    "test:related": "vitest related --run --config vitest.fast.config.ts",
    "test:suites:audit": "vitest run --config vitest.fast.config.ts __tests__/testSuiteManifest.test.ts",
    "test:regression": "vitest run --config vitest.regression.config.ts",
    "test:scientific:canonical": "vitest run --config vitest.canonical.config.ts",
    "test:nightly": "npm run test:regression && npm run test:scientific:canonical",
    "test:all": "npm run test:suites:audit && npm run test:fast && npm run test:regression && npm run test:scientific:canonical",
    "test:watch": "vitest --config vitest.fast.config.ts",
    "test:watch:all": "vitest --config vitest.config.ts",
    "benchmark:coronary:v2-atomic-step": "vite-node --script tools/coronary/benchmarkMainWireFiveWallCoronaryTransactionV2.ts",
    "run:coronary:v2-periodic": "vite-node --script tools/coronary/runMainWireFiveWallCoronaryPeriodicSteadyV2.ts",
    "verify:scientific:valve-research-bracket-numerical-envelope": "vite-node --script tools/scientific/runMainWireValveResearchBracketNumericalRobustnessEnvelopeV1.ts",
    "verify:scientific:integrated-periodic-v3": "vite-node --script tools/scientific/runMainWireIntegratedModelPeriodicSteadyV3.ts",
    "render:scientific:integrated-periodic-v3-svg": "vite-node --script tools/scientific/renderMainWireIntegratedModelPeriodicSteadyArtifactSvgV3.ts",
    "characterize:device:hmii-stanfield-mean-context:v1": "vite-node --script tools/scientific/runHeartMateIiStanfieldMeanOperatingPointContextV1.ts",
    "characterize:coronary:v3-reduced-pressure-step-numerical": "vite-node --script tools/scientific/runCoronaryV3ReducedPressureStepNumericalCharacterizationV1.ts --output artifacts/coronary-v3/reduced-pressure-step-numerical-v1.json",
    "characterize:coronary:v3-reduced-pressure-step-numerical:v2": "vite-node --script tools/scientific/runCoronaryV3ReducedPressureStepNumericalCharacterizationV2.ts --output artifacts/coronary-v3/reduced-pressure-step-numerical-v2.json",
    "characterize:coronary:v3-lesion-structural-cmd-directional:v1": "vite-node --script tools/scientific/runCoronaryV3LesionStructuralCmdDirectionalCharacterizationV1.ts --output artifacts/coronary-v3/lesion-structural-cmd-directional-v1.json",
    "characterize:coronary:v3-structural-cmd-active-reserve:v2": "vite-node --script tools/scientific/runCoronaryV3StructuralCmdActiveReserveCharacterizationV2.ts --output artifacts/coronary-v3/structural-cmd-active-reserve-v2.json",
    "render:coronary:v3-reduced-pressure-step-diagnostic:v1": "vite-node --script tools/scientific/renderCoronaryV3ReducedPressureStepArtifactsSvgV1.ts --v1-input artifacts/coronary-v3/reduced-pressure-step-numerical-v1.json --v2-input artifacts/coronary-v3/reduced-pressure-step-numerical-v2.json --output artifacts/coronary-v3/reduced-pressure-step-raw-diagnostic-v1.svg",
    "validate:mechanical-support:v1": "vite-node --script tools/devices/generateMechanicalSupportValidationV1.ts",
    "qualify:baseline": "vite-node --script tools/scientific/qualifyMainWireStaticBaselineV1.ts",
    "test:browser:public": "VITE_SUPABASE_URL=https://public-content.test VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_fixture npm run build && playwright test --config playwright.public-content.config.ts",
    "build:model:cardiorespiratory-dev": "npm run compile:model:cardiorespiratory-dev && vite-node --script tools/model/buildCardiorespiratoryDevV1.ts",
    "compile:model:cardiorespiratory-dev": "vite-node --script tools/model/compileCardiorespiratoryExecutionPlanV1.ts --write --summary",
    "prepare:model:cardiorespiratory-dev": "vite-node --script tools/scientific/prepareCardiorespiratoryStartupPresetsV1.ts",
    "prepare:model:cardiorespiratory-dev:strict": "vite-node --script tools/scientific/prepareCardiorespiratoryDevPresetsV1.ts",
    "calibrate:model:cardiorespiratory-startup": "vite-node --script tools/scientific/calibrateCardiorespiratoryStartupV1.ts",
    "qualify:model:cardiorespiratory-dev": "vite-node --script tools/scientific/qualifyCardiorespiratoryDevV1.ts",
    "benchmark:model:cardiorespiratory-dev": "vite-node --script tools/performance/benchmarkCardiorespiratoryDevV1.ts",
    "benchmark:workbench:cardiorespiratory-dev": "vite-node --script tools/performance/measureCardiorespiratoryBrowserV1.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.1",
    "budoux": "^0.9.1",
    "dockview": "^6.6.1",
    "i18next": "^26.3.1",
    "katex": "^0.18.3",
    "lucide-react": "^1.17.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.9"
  }
}
